# Every variable Mesimot reads. Put real values in ~/.config/mesimot/env (created by deploy/install.sh), never in the repository.
# Nothing here is a credential of an AI vendor: the agent CLIs use their own login.

# --- core
MESIMOT_TOKEN=            # API token for the CLI (generated by install.sh)
MESIMOT_PORT=8110         # site port (127.0.0.1)
MESIMOT_DB=               # database file (default data/mesimot.db)
MESIMOT_FILES=            # archive directory (default files/)
MESIMOT_CONFIG=           # path of the config file (default config/mesimot.config.json)
MESIMOT_SITE_URL=         # overrides site_url from the config
MESIMOT_PUBLIC_URL=       # overrides public_url (watchdog probes it)

# --- the assistant's brain (automatic mode): the user's own agent CLI, headless
MESIMOT_AGENT=claude-code # claude-code | codex | gemini (Settings can override it)
MESIMOT_AGENT_MODEL=      # optional model name passed to the agent CLI
MESIMOT_CLAUDE_BIN=       # optional path of the claude / codex / gemini binaries
MESIMOT_CODEX_BIN=
MESIMOT_GEMINI_BIN=
MESIMOT_JOB_MODELS=       # benchmark override: job=model:effort[:fallback],... e.g. pulse=haiku:low:sonnet
MESIMOT_RUN_TIMEOUT_S=600 # one headless run may last this long

# --- mail provider: agentmail (default) or imap (Proton Mail Bridge, see docs/PROTON.md)
MAIL_PROVIDER=agentmail
MAIL_FALLBACK_PROVIDER=        # optional intake-only second provider (agentmail) after a move to imap
MAIL_FALLBACK_UNTIL=          # ISO date after which the fallback switches itself off
MAIL_IMAP_HOST=127.0.0.1      # imap only
MAIL_IMAP_PORT=1143
MAIL_IMAP_USER=               # Bridge-generated credentials
MAIL_IMAP_PASS=
MAIL_IMAP_STARTTLS=1          # 0 for a plain test server
MAIL_SMTP_HOST=127.0.0.1
MAIL_SMTP_PORT=1025
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_SMTP_STARTTLS=1
MAIL_ADDRESS=assistant@proton.example  # the assistant's own Proton address (SMTP From)
MAIL_OWNER_ADDRESS=           # the owner's own Proton address: accepted as internal Proton mail (unset = rule off)
MAIL_TLS_INSECURE_LOCAL=0     # 1: accept the Bridge's self-signed certificate, ONLY for 127.0.0.1
MAIL_IMAP_SCOPE_FOLDERS=INBOX,Folders/tasks.example.org/Inbox  # the only intake folders the provider may open (INBOX before the Proton filter, the own folder after it)
MAIL_IMAP_SENT_FOLDER=Folders/tasks.example.org/Sent         # our outgoing copies (a COPY of the Sent message; Sent itself is never modified)
MAIL_SENT_RETENTION_DAYS=90
MAIL_IMAP_DONE_FOLDER=Labels/Alex-done
MAIL_HOUSEKEEPING=trash       # trash (Trash + remove the label) | labels (remove the done label only)
MAIL_REMOVE_LABEL_AFTER_DONE=0
MAIL_TRASH_FOLDER=Trash
# agentmail: the key lives in ~/.config/agentmail/env as AGENTMAIL_API_KEY
MESIMOT_INBOX=            # overrides inbox from the config
MESIMOT_POLL_EMAIL=1      # 0 disables mail polling (development)

# --- Telegram (optional)
TELEGRAM_BOT_TOKEN=       # from @BotFather
TELEGRAM_API_BASE=        # http://127.0.0.1:8081 once the local Bot API server is in use (files up to 2 GB)
TELEGRAM_API_ID=          # only for the local Bot API server (my.telegram.org)
TELEGRAM_API_HASH=        # only for the local Bot API server; never print or commit it
TELEGRAM_LOCAL_DIR=       # host path of the local server's volume (default data/botapi)
MESIMOT_TELEGRAM=1        # 0 disables the bot

# --- voice, search, files (defaults are fine)
MESIMOT_PYTHON=           # python of the voice venv (default venv/bin/python)
MESIMOT_SEMANTIC=1        # 0 disables the embedding model (semantic search)
MESIMOT_PDF_PAGES=300     # PDF pages indexed for huge files
MESIMOT_CHUNK_BYTES=      # chunk size of web uploads (default 32 MB)
MESIMOT_INLINE_INDEX_BYTES= # files up to this size are indexed at once (default 20 MB), bigger ones in the background

# --- development only
MESIMOT_NO_SYSTEMD=0      # 1: the status card skips systemd checks
MESIMOT_NO_BG=0           # 1: no background extraction process (tests)
MESIMOT_QUIET_S=60        # seconds of quiet before a batch run
MESIMOT_MAX_WAIT_S=120
MESIMOT_DB_KEY_FILE=        # master encryption key file (default ~/.config/mesimot/db.key); see docs/ENCRYPTION.md
