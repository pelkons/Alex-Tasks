#!/usr/bin/env node
'use strict';
// CLI for Mesimot. Writes through the local API with the token, so every change is logged as the assistant.
const fs = require('fs');
const os = require('os');
const path = require('path');
const root = path.join(__dirname, '..');
const { readEnvFile } = require(path.join(root, 'lib', 'server.js'));

const BASE = process.env.MESIMOT_URL || 'http://127.0.0.1:8110';

function parse(argv) {
  const pos = [], opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const eq = k.indexOf('=');
      if (eq >= 0) opt[k.slice(0, eq)] = k.slice(eq + 1);
      else if (i + 1 < argv.length && !argv[i + 1].startsWith('--')) opt[k] = argv[++i];
      else opt[k] = true;
    } else pos.push(a);
  }
  return { pos, opt };
}

const out = (v) => console.log(JSON.stringify(v, null, 2));
function fail(msg, code = 1) { console.error(JSON.stringify({ error: msg })); process.exit(code); }

async function api(method, url, body) {
  const token = process.env.MESIMOT_TOKEN || readEnvFile().MESIMOT_TOKEN;
  if (!token) fail('API token not found in ~/.config/mesimot/env');
  let res;
  try {
    res = await fetch(BASE + url, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(body !== undefined ? { 'Content-Type': 'application/json' } : {}) },
      body: body !== undefined ? JSON.stringify(body) : undefined,
    });
  } catch (e) { fail(`cannot reach server at ${BASE}: ${e.message}`); }
  const data = await res.json().catch(() => ({}));
  if (!res.ok) fail(data.error || `HTTP ${res.status}`);
  return data;
}

const qs = (o, keys) => {
  const p = new URLSearchParams();
  for (const k of keys) if (o[k] !== undefined && o[k] !== true) p.set(k === 'all' ? 'include_hidden' : k, o[k]);
  if (o.all) p.set('include_hidden', '1');
  const s = p.toString();
  return s ? '?' + s : '';
};

const pick = (o, keys) => {
  const r = {};
  for (const k of keys) if (o[k] !== undefined) r[k] = o[k] === true ? '' : o[k];
  return r;
};
const nullable = (v) => (v === 'none' || v === '' ? null : v);

function setWebPassword(opt) {
  if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
  const { open } = require(path.join(root, 'lib', 'db.js'));
  const auth = require(path.join(root, 'lib', 'auth.js'));
  const db = open(process.env.MESIMOT_DB);
  let pw;
  if (opt.generate) {
    pw = require('crypto').randomBytes(18).toString('base64url');
    const file = typeof opt.out === 'string' ? opt.out : path.join(os.homedir(), '.config', 'mesimot', 'web-password.txt');
    fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
    fs.writeFileSync(file, pw + '\n', { mode: 0o600 });
    fs.chmodSync(file, 0o600);
    auth.setPassword(db, pw);
    out({ ok: true, saved_to: file });
    return;
  }
  const finish = (p) => { try { auth.setPassword(db, p); out({ ok: true }); } catch (e) { fail(e.message); } };
  if (opt.stdin) { finish(fs.readFileSync(0, 'utf8').replace(/\r?\n$/, '')); return; }
  if (!process.stdin.isTTY) fail('run in a terminal, or use --stdin / --generate');
  const readline = require('readline');
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout, terminal: true });
  rl._writeToOutput = function (s) { if (s.includes('\n') || s.startsWith('Password') || s.startsWith('Repeat')) rl.output.write(s); };
  rl.question('Password (12+ chars): ', (p1) => {
    rl.question('\nRepeat: ', (p2) => {
      rl.close();
      console.log();
      if (p1 !== p2) fail('passwords do not match');
      finish(p1);
    });
  });
}

const USAGE = `mesimot <command>
  task list|show|add|update      note add      draft add
  project list|find|propose|add (owner only)|update|merge|resolve|show|pending   person list|find|add [--status partial --company --role-text]|update|merge|resolve|show
  pending     ack <id...>        attention add|list|update
  usage [--days N] [--by kind|model] [--json]   (agent usage, API-equivalent cost)
  chat send --text "..." [--file FILEID[,FILEID]]   (--file sends the document(s) to the owner: web chip + Telegram document)
  push status | push test   (web push to the owner's phone: subscribed devices, one test notification)
  health [--quick] [--json] [--no-alert]   (every system check; --quick = UI smoke test + APIs, the post-deploy gate)
  connector publish <AlexLink-Setup-<version>.exe>   (copies the installer to data/connector/ and writes latest.json)
  style for --to "a@b.com, Name" [--reply-email ID] [--task ID]   (BEFORE any mail: the owner's style for them, the guide, his real mails to them, his edits) | check --to .. --body .. | feedback --to .. | list | show <key> | suggest <key> --reason ..
  style analyse [--person "A,B"] [--group G [--classify "what the group is"] [--domains a.com,b.com]] [--role boss|unknown|pm|internal|external] [--default] [--force] [--dry]   (PROPOSED styles from your own sent mail; owner only)   style try --to .. --say ..   (a dry draft)
  outbox draft --to "a@b.com, Name (c@d.com)" --subject S --body TEXT [--kind new|reply|reply_all|forward] [--reply-email EMAILID] [--cc ..] [--bcc ..] [--attach FILEID,..] [--task ID] | update <id> ... | cancel <id> | list | show <id>   (DRAFTS only: the owner approves with a button)
  confirm task-delete <id> | project-delete <project> --tasks move:<project>|unassign|delete | person-delete <id> | protocol-delete <id>   (asks the owner with two buttons; his "yes" moves it to the recycle bin)
  trash list [--kind task|project|person|protocol|calendar|chat|filter] | restore <trash id> | delete <trash id> | empty   (recycle bin; delete and empty are PERMANENT: they ask the owner like confirm)
  filter list|add|preview|delete|enable|disable   (owner mail filters: --sender/--domain/--text/--regex --action skip|fyi|relevant [--project P])
  ask "<question>" [--project P]   (Q&A retrieval: synonyms + keyword + semantic, with file/page)
  search "<query>" [--archive 1 (closed tasks too)] [--mail_archive 0|only (old Outlook mail: excluded / only; default included)] [--project --person --kind --from --to --limit --mode keyword|semantic|hybrid]
  archive status | failed | retry | estimate   (the Outlook mail archive: queue, text-only counts, disk, speed)
  show task|email|knowledge|chunk|file <id>
  calendar list|add|update|delete  calendar-token [--rotate]
  project profile <project> [--buildings N --floors "8, 12" --units-new N --units-existing N --track .. --commercial .. --contractor .. --architect ..] --as-of YYYY-MM-DD --source email:<id>   (the PASSPORT; no field = show)
  project status <project> --process design|permit|construction|marketing --text "..." --as-of YYYY-MM-DD --source email:<id>|file:<id>|protocol:<id>|chat:<id>   (latest status per process; no --text = show)
  knowledge list|add|update|supersede   fact set [--topic T]|list|topic   file list|classify
  protocol add|list|show|item add|update|promote|done|dismiss   telegram send|status|bind        chat send --text "..." [--task 5,6] [--task-scope ID|0]  chat list      email show|thread <id>
  apply [--dry] < decisions.json   (structured answer: decisions, new_tasks, knowledge, chat_message)
  run-summary --text "..."
  rekey [--dry]   (rotate the encryption key: database, stored files and backups; see docs/ENCRYPTION.md)
  backup offsite [--dry-run] | restore-test | status   (nightly encrypted off-site backup to Proton Drive; see docs/BACKUP.md)
  vault cat <file> | status   (read a stored encrypted file, e.g. a run log; count encrypted and plain files)
  sql "<query>" [--write] [--db FILE] [--format json|tsv]   (direct database access for the owner/developer: the database is encrypted, so the sqlite3 tool cannot open it)
  web-password [--generate]`;

async function main() {
  const { pos, opt } = parse(process.argv.slice(2));
  const [cmd, sub, arg] = pos;
  if (!cmd || opt.help) { console.log(USAGE); return; }

  switch (cmd) {
    case 'web-password': return setWebPassword(opt);
    case 'init-config': { // used by deploy/install.sh: writes config/mesimot.config.json from the example and the answers (never overwrites an existing file)
      const fs = require('fs'), path = require('path');
      const root = path.join(__dirname, '..'), target = path.join(root, 'config', 'mesimot.config.json');
      if (fs.existsSync(target) && !opt.force) { console.log('config/mesimot.config.json exists: left as it is'); return; }
      const c = JSON.parse(fs.readFileSync(path.join(root, 'config', 'mesimot.config.example.json'), 'utf8'));
      const set = (o, k, v) => { if (v !== undefined && v !== true && v !== '') o[k] = v; };
      set(c.owner, 'name_he', opt['owner-name-he']); set(c.owner, 'name_en', opt['owner-name-en']);
      if (opt['owner-email']) { c.owner.emails = String(opt['owner-email']).split(',').map((x) => x.trim()); c.owner.work_email = c.owner.emails[0]; c.digest_to = c.owner.emails[c.owner.emails.length - 1]; }
      set(c.assistant, 'name_he', opt['assistant-name-he']); set(c.assistant, 'name_en', opt['assistant-name-en']);
      if (opt.domain) { c.site_url = String(opt.domain).replace(/\/$/, ''); c.public_url = c.site_url; }
      set(c, 'inbox', opt.inbox); set(c, 'timezone', opt.timezone);
      c.mirror_url = ''; c.tunnel_id = opt['tunnel-id'] && opt['tunnel-id'] !== true ? opt['tunnel-id'] : '';
      c.team = []; c.bosses = [];
      fs.mkdirSync(path.dirname(target), { recursive: true });
      fs.writeFileSync(target, JSON.stringify(c, null, 2) + '\n');
      console.log('created config/mesimot.config.json');
      return;
    }
    case 'render-agent': { const dir = require('path').resolve(opt.dir || require('path').join(__dirname, '..', 'agent')); console.log('rendered', require('../lib/agentdoc').install(dir)); return; }
    case 'search': {
      if (!sub) fail('usage: search "<query>" [--archive 1]');
      return out(await api('GET', '/api/search' + qs({ q: sub, ...opt }, ['q', 'project', 'person', 'kind', 'from', 'to', 'limit', 'mode', 'archive', 'mail_archive'])));
    }
    case 'archive': { // the Outlook MAIL archive (old mail, text only beyond a year; docs/OUTLOOK-INGEST.md): `archive status | failed | retry | estimate`
      if (!sub || sub === 'status') return out(await api('GET', '/api/mail-archive/status'));
      if (sub === 'failed') return out(await api('GET', '/api/mail-archive/failed'));
      if (sub === 'retry') return out(await api('POST', '/api/mail-archive/retry', {}));
      if (sub === 'estimate') return out(await api('GET', '/api/mail-archive/estimate' + qs(opt, ['emails', 'full_share'])));
      fail('usage: archive status | failed | retry | estimate [--emails 20000 --full_share 0.3]');
    }
    case 'show': {
      if (!['task', 'email', 'knowledge', 'chunk', 'file'].includes(sub) || !arg) fail('usage: show task|email|knowledge|chunk|file <id>');
      const url = { task: `/api/tasks/${arg}`, email: `/api/emails/${arg}`, knowledge: `/api/knowledge/${arg}`, chunk: `/api/chunks/${arg}`, file: `/api/files/${arg}/show` }[sub];
      return out(await api('GET', url));
    }
    case 'knowledge':
      if (sub === 'list') return out(await api('GET', '/api/knowledge' + qs(opt, ['project', 'include_superseded'])));
      if (sub === 'add') return out(await api('POST', '/api/knowledge', pick(opt, ['project', 'kind', 'title', 'body', 'source', 'source_ref'])));
      if (sub === 'update') { if (!arg) fail('missing id'); return out(await api('PATCH', `/api/knowledge/${arg}`, pick(opt, ['project', 'kind', 'title', 'body']))); }
      if (sub === 'supersede') { if (!arg) fail('missing id'); return out(await api('POST', `/api/knowledge/${arg}/supersede`, pick(opt, ['by', 'title', 'body', 'source', 'source_ref']))); }
      break;
    case 'protocol': {
      if (sub === 'list') return out(await api('GET', '/api/protocols' + qs(opt, ['project'])));
      if (sub === 'show') { if (!arg) fail('missing id'); return out(await api('GET', `/api/protocols/${arg}`)); }
      if (sub === 'add') {
        const b = pick(opt, ['project', 'date', 'title', 'location', 'participants', 'source', 'summary']);
        if (opt['next-meeting']) b.next_meeting_at = opt['next-meeting'];
        return out(await api('POST', '/api/protocols', b));
      }
      if (sub === 'item') {
        const [, , action, idArg] = pos;
        if (action === 'add') { if (!opt.protocol) fail('--protocol required'); const b = pick(opt, ['kind', 'text', 'owner', 'party', 'due']); if (opt.recommended) b.recommended = true; return out(await api('POST', `/api/protocols/${opt.protocol}/items`, b)); }
        if (action === 'update') { if (!idArg) fail('missing item id'); const b = pick(opt, ['kind', 'text', 'owner', 'party', 'due', 'status']); if (opt.recommended !== undefined) b.recommended = opt.recommended !== 'false'; return out(await api('PATCH', `/api/protocol-items/${idArg}`, b)); }
        if (['promote', 'done', 'dismiss'].includes(action)) { if (!idArg) fail('missing item id'); return out(await api('POST', `/api/protocol-items/${idArg}/${action}`, {})); }
      }
      break;
    }
    case 'calendar':
      if (sub === 'list') return out(await api('GET', '/api/calendar' + qs(opt, ['from', 'to', 'q'])));
      if (sub === 'add') return out(await api('POST', '/api/calendar/items', pick(opt, ['title', 'start', 'end', 'location', 'description', 'task', 'project', 'email'])));
      if (sub === 'update') { if (!arg) fail('missing id'); return out(await api('PATCH', `/api/calendar/items/${arg}`, pick(opt, ['title', 'start', 'end', 'location', 'description']))); }
      if (sub === 'delete') { if (!arg) fail('missing id'); return out(await api('DELETE', `/api/calendar/items/${arg}`)); }
      break;
    case 'calendar-token':
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      return out(await api(sub === '--rotate' || opt.rotate ? 'POST' : 'GET', opt.rotate || sub === '--rotate' ? '/api/calendar/token' : '/api/calendar/info', opt.rotate ? {} : undefined));
    case 'ask': {
      const question = pos.slice(1).join(' ').trim() || opt.q;
      if (!question) fail('usage: mesimot ask "<question>" [--project P]');
      return out(await api('GET', '/api/ask' + qs({ q: question, project: opt.project, limit: opt.limit, mail_archive: opt.mail_archive }, ['q', 'project', 'limit', 'mail_archive'])));
    }
    case 'usage': {
      const u = await api('GET', '/api/usage' + qs({ days: opt.days, by: opt.by }, ['days', 'by']));
      if (opt.json) return out(u);
      const line = (r) => `${String(r.label || r.key).padEnd(26)} ${String(r.runs).padStart(5)} runs  ${String(r.input + r.output).padStart(9)} tok  cache ${String(r.cache_read + r.cache_write).padStart(10)}  $${r.cost.toFixed(2).padStart(7)}  ${Math.round(r.avg_ms / 1000)}s avg`;
      console.log(`API-equivalent cost (an estimate; the subscription is a flat fee with limits)`);
      for (const [n, t] of [['today', u.today], ['7 days', u.week], ['30 days', u.month]]) console.log(`${n.padEnd(8)} ${t.runs} runs, in ${t.input} out ${t.output} cache ${t.cache_read + t.cache_write}, $${t.cost.toFixed(2)}, rate-limit hits ${t.limited}`);
      console.log(`\nby ${opt.by === 'model' ? 'model' : 'kind'} (last ${u.days} days):`); for (const r of u.by) console.log(line(r));
      if (u.imports.length) { console.log('\ndaily imports:'); for (const i of u.imports) console.log(`#${i.id} ${i.emails} emails, ${i.runs} runs, $${i.cost.toFixed(2)} ($${i.per_email ?? '-'} per email)`); }
      console.log(`\nrate-limit events: ${u.rate_limit_events.week} (7d), ${u.rate_limit_events.month} (30d)${u.rate_limit_events.backoff_until ? ', background paused until ' + u.rate_limit_events.backoff_until : ''}`);
      return;
    }
    case 'fact':
      if (sub === 'set') { const body = pick(opt, ['project', 'key', 'value', 'unit', 'source', 'topic']); if (opt['as-of']) body.as_of = opt['as-of']; return out(await api('POST', '/api/facts', body)); }
      if (sub === 'list') return out(await api('GET', '/api/facts' + qs({ project: opt.project, history: opt.history ? '1' : undefined }, ['project', 'history'])));
      if (sub === 'topic') { if (!opt.topic) fail('usage: fact topic <fact id> --topic design|permit|construction|finance|marketing|people|other   or   fact topic --project P --key "<key>" --topic ...'); return out(await api('POST', '/api/facts/topic', { id: arg, project: opt.project, key: opt.key, topic: opt.topic })); }
      break;
    case 'file':
      if (sub === 'list') return out(await api('GET', '/api/files' + qs(opt, ['project'])));
      if (sub === 'classify') { if (!arg) fail('missing file id'); return out(await api('PATCH', `/api/files/${arg}`, pick(opt, ['project', 'task', 'summary', 'facts_checked']))); }
      break;
    case 'chat':
      if (sub === 'send') return out(await api('POST', '/api/chat', { ...pick(opt, ['text', 'task', 'file']), ...(opt['task-scope'] !== undefined && opt['task-scope'] !== true ? { task_scope: opt['task-scope'] } : {}), ...(opt['entity-scope'] !== undefined && opt['entity-scope'] !== true ? { entity_scope: opt['entity-scope'] } : {}), ...(opt.main ? { main: true } : {}) }));
      if (sub === 'list') return out(await api('GET', '/api/chat' + qs({ limit: opt.limit || 20 }, ['limit'])));
      break;
    case 'email':
      if (sub === 'show') { if (!arg) fail('missing id'); return out(await api('GET', `/api/emails/${arg}`)); }
      if (sub === 'thread') { if (!arg) fail('missing id'); return out(await api('GET', `/api/emails/${arg}/thread`)); }
      break;
    case 'telegram':
      if (sub === 'send') return out(await api('POST', '/api/chat', pick(opt, ['text', 'task'])));
      if (sub === 'status') return out(await api('GET', '/api/telegram/status'));
      if (sub === 'bind') { if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant'); return out(await api('POST', '/api/telegram/bind', {})); }
      break;
    case 'apply': {
      const raw = opt.json ? opt.json : opt.file ? fs.readFileSync(opt.file, 'utf8') : fs.readFileSync(0, 'utf8');
      let payload; try { payload = JSON.parse(raw); } catch (e) { fail('stdin must be JSON: ' + e.message); }
      return out(await api('POST', '/api/apply' + (opt.dry ? '?dry=1' : ''), payload));
    }
    case 'run-summary': return out(await api('POST', '/api/run-summary', { text: opt.text }));
    case 'pending': return out(await api('GET', '/api/pending'));
    case 'ack': {
      const ids = pos.slice(1).flatMap((x) => String(x).split(',')).map(Number).filter(Boolean);
      return out(await api('POST', '/api/ack', { ids }));
    }
    case 'task':
      if (sub === 'list') return out(await api('GET', '/api/tasks' + qs(opt, ['project', 'assignee', 'requester', 'status', 'priority', 'q', 'stale_days', 'overdue', 'all'])));
      if (sub === 'show') return out(await api('GET', `/api/tasks/${arg}`));
      if (sub === 'add') return out(await api('POST', '/api/tasks', pick(opt, ['title', 'project', 'assignee', 'requester', 'status', 'priority', 'due', 'source-date', 'due-source', 'email', 'desc', 'parent', 'unassigned-reason'])));
      if (sub === 'update') {
        if (!arg) fail('missing task id');
        const body = pick(opt, ['title', 'project', 'assignee', 'requester', 'status', 'priority', 'due', 'source-date', 'due-source', 'desc', 'parent', 'email', 'relation']);
        for (const k of ['assignee', 'requester', 'due', 'source-date', 'parent']) if (k in body) body[k] = nullable(body[k]);
        return out(await api('PATCH', `/api/tasks/${arg}`, body));
      }
      break;
    case 'note':
      if (sub === 'add') {
        if (!opt.task && !opt.project) fail('--task or --project required');
        return out(await api('POST', '/api/notes', { task: opt.task, project: opt.project, text: opt.text, kind: opt.kind }));
      }
      break;
    case 'draft':
      if (sub === 'add') { if (!opt.task) fail('--task required'); return out(await api('POST', `/api/tasks/${opt.task}/drafts`, { text: opt.text, ...(opt.long ? { long: true } : {}) })); }
      break;
    case 'project':
      if (sub === 'list') return out(await api('GET', '/api/projects'));
      if (sub === 'find') { const needle = pos.slice(2).join(' ').toLowerCase(); if (!needle) fail('usage: project find "<name or alias>"'); const all = await api('GET', '/api/projects'); return out(all.filter((x) => [x.name_he, ...(x.aliases || [])].filter(Boolean).join(' ').toLowerCase().includes(needle)).slice(0, 10).map((x) => ({ id: x.id, name_he: x.name_he, aliases: x.aliases, open_count: x.open_count }))); }
      if (sub === 'add') { const b = pick(opt, ['name', 'aliases', 'description', 'status', 'color', 'from']); if (opt.partial) b.partial = true; return out(await api('POST', '/api/projects', b)); } // the assistant's call becomes a proposal (202 pending_approval): only the owner creates a project
      if (sub === 'propose') { const name = opt.name || pos.slice(2).join(' '); if (!name) fail('usage: project propose "<name>" [--aliases a,b] [--from email:<id>|chat:<id>|protocol:<id>] [--context "<one line>"] [--attach task:12,email:5]'); return out(await api('POST', '/api/projects/propose', { name, ...pick(opt, ['aliases', 'from', 'context', 'description', 'attach']) })); }
      if (sub === 'pending') return out(await api('GET', '/api/project-proposals' + qs(opt, ['status'])));
      if (sub === 'show') { if (!arg) fail('missing project'); return out(await api('GET', `/api/projects/${encodeURIComponent(arg)}/show`)); }
      if (sub === 'profile') { // the PASSPORT: no field = show it
        if (!arg) fail('usage: project profile <project> [--buildings N] [--floors "8, 12"] [--units-new N] [--units-existing N] [--track "..."] [--commercial "..."] [--contractor "..."] [--architect "..."] --as-of YYYY-MM-DD --source email:<id>|file:<id>|protocol:<id>|chat:<id> | [--history]');
        const fields = {}; for (const k of ['buildings', 'floors', 'units-new', 'units-existing', 'track', 'commercial', 'contractor', 'architect']) if (opt[k] !== undefined && opt[k] !== true) fields[k.replace('-', '_')] = opt[k];
        if (!Object.keys(fields).length) return out(await api('GET', `/api/projects/${encodeURIComponent(arg)}/profile${opt.history ? '?history=1' : ''}`));
        return out(await api('POST', `/api/projects/${encodeURIComponent(arg)}/profile`, { ...fields, as_of: opt['as-of'], source: opt.source }));
      }
      if (sub === 'status') { // the LATEST STATUS of one process: no --text = show all of them
        if (!arg) fail('usage: project status <project> --process design|permit|construction|marketing --text "..." --as-of YYYY-MM-DD --source email:<id>|file:<id>|protocol:<id>|chat:<id> | [--history]');
        if (opt.text === undefined || opt.text === true) { const pr = await api('GET', `/api/projects/${encodeURIComponent(arg)}/profile${opt.history ? '?history=1' : ''}`); return out(pr.statuses); }
        if (!opt.process) fail('--process design|permit|construction|marketing required');
        return out(await api('POST', `/api/projects/${encodeURIComponent(arg)}/status`, { process: opt.process, text: opt.text, as_of: opt['as-of'], source: opt.source }));
      }
      if (sub === 'update') { if (!arg) fail('missing project'); return out(await api('PATCH', `/api/projects/${encodeURIComponent(arg)}`, pick(opt, ['name', 'aliases', 'description', 'status', 'color', 'summary', 'partial']))); }
      if (sub === 'resolve') { if (!arg) fail('usage: project resolve <vague> --into <project> | --name ... --aliases ...'); const b = pick(opt, ['into', 'name', 'aliases', 'description']); return out(await api('POST', `/api/projects/${encodeURIComponent(arg)}/resolve`, b)); }
      if (sub === 'merge') { if (!arg || !pos[3]) fail('usage: project merge <from> <into>'); return out(await api('POST', `/api/projects/${encodeURIComponent(arg)}/merge`, { into: pos[3] })); }
      break;
    case 'health': { // the full system check (opens the real UI in headless Chrome); not for the assistant
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      const r = require('child_process').spawnSync(process.execPath, [require('path').join(__dirname, 'mesimot-health'), ...process.argv.slice(3)], { stdio: 'inherit' });
      process.exit(r.status ?? 2); }
    case 'sql': { // the replacement for the sqlite3 command line tool (the database file is encrypted): read-only unless --write
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      const write = !!opt.write; // `--write "<query>"` makes the parser take the query as the flag's value
      const query = [typeof opt.write === 'string' ? opt.write : undefined, sub, arg, ...pos.slice(3)].filter((x) => x !== undefined).join(' ').trim();
      if (!query) fail('usage: sql "<query>" [--write] [--db FILE] [--format json|tsv]   (also: ".tables", ".schema [table]")');
      const { openRaw } = require('../lib/dbkey');
      const file = require('path').resolve(opt.db || process.env.MESIMOT_DB || require('path').join(__dirname, '..', 'data', 'mesimot.db'));
      let db; try { db = openRaw(file, { readonly: !write }); } catch (e) { fail(e.message); }
      try { db.pragma('busy_timeout = 15000'); require('sqlite-vec').load(db); } catch { /* vector tables are optional */ }
      let sql = query;
      if (/^\.tables$/i.test(sql)) sql = "SELECT name FROM sqlite_master WHERE type IN ('table','view') ORDER BY name";
      else if (/^\.schema/i.test(sql)) { const t = sql.replace(/^\.schema\s*/i, '').trim(); sql = t ? `SELECT sql FROM sqlite_master WHERE tbl_name='${t.replace(/'/g, "''")}'` : 'SELECT sql FROM sqlite_master WHERE sql IS NOT NULL'; }
      try {
        let st; try { st = db.prepare(sql); } catch (e) { if (write && /more than one statement/i.test(e.message)) { db.exec(sql); return out({ ok: true }); } throw e; }
        if (st.reader) {
          const rows = st.all();
          if (opt.format === 'tsv') { if (rows.length) console.log(Object.keys(rows[0]).join('\t')); for (const r of rows) console.log(Object.values(r).map((v) => (v === null ? '' : String(v).replace(/[\t\n]/g, ' '))).join('\t')); }
          else out(rows);
        } else { if (!write) fail('this statement changes data: add --write'); out(st.run()); }
      } catch (e) { fail(e.message); } finally { try { db.close(); } catch { /* ignore */ } }
      return; }
    case 'push': { // web push to the owner's installed web app (docs/PUSH.md): `push status` (devices), `push test` (one test notification to every device)
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      if (!['status', 'test'].includes(sub)) fail('usage: push status | push test');
      const pdb = require('../lib/db').open(process.env.MESIMOT_DB || require('path').join(__dirname, '..', 'data', 'mesimot.db'));
      const p = require('../lib/push').createPush(pdb, { notify: require('../lib/notify').createNotify(pdb, require('../lib/store').createStore(pdb)) });
      if (sub === 'status') return out({ devices: p.devices().map((d) => ({ id: d.id, label: d.label, created_at: d.created_at, last_ok_at: d.last_ok_at, last_error: d.last_error })), categories: p.settings() });
      const r = await p.test(); if (!r.devices) fail('no device is subscribed yet: switch on notifications in Settings on the phone first');
      return out(r); }
    case 'rekey': { // rotate the encryption key: database, stored files, backups (scripts/rekey.js)
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      const r = require('child_process').spawnSync(process.execPath, [require('path').join(__dirname, '..', 'scripts', 'rekey.js'), ...process.argv.slice(3)], { stdio: 'inherit' });
      process.exit(r.status ?? 2); }
    case 'backup': { // `backup offsite [--dry-run]`, `backup restore-test`, `backup status`: the encrypted off-site copy on Proton Drive (scripts/offsite-backup.js)
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      const flagFor = { offsite: [], 'restore-test': ['--restore-test'], status: ['--status'] }[sub];
      if (!flagFor) fail('usage: backup offsite [--dry-run] | backup restore-test | backup status');
      const r = require('child_process').spawnSync(process.execPath, [require('path').join(__dirname, '..', 'scripts', 'offsite-backup.js'), ...flagFor, ...(opt['dry-run'] ? ['--dry-run'] : [])], { stdio: 'inherit' });
      process.exit(r.status ?? 2); }
    case 'vault': { // `vault cat <file>` prints a stored (encrypted) file, e.g. a run log; `vault status` counts encrypted and plain files
      if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
      const vault = require('../lib/vault');
      if (sub === 'cat' && arg) { try { process.stdout.write(vault.readFile(require('path').resolve(arg))); } catch (e) { fail(e.message); } return; }
      if (sub === 'status') { const roots = [process.env.MESIMOT_FILES || require('path').join(root, 'files'), process.env.MESIMOT_RUN_LOG || require('path').join(root, 'data', 'runs'), require('../lib/archive').queueDir()]; let enc = 0, plain = 0; const walk = (d) => { for (const e of fs.readdirSync(d, { withFileTypes: true })) { const p = require('path').join(d, e.name); if (e.isDirectory()) walk(p); else if (e.isFile()) { if (vault.isEncrypted(p)) enc++; else plain++; } } }; for (const r of roots) if (fs.existsSync(r)) walk(r); return out({ encrypted: enc, plain }); }
      fail('usage: vault cat <file> | vault status'); return; }
    case 'connector': { // the Windows connector installer: `connector publish <AlexLink-Setup-1.0.0.exe>`
      if (sub !== 'publish' || !arg) fail('usage: connector publish <AlexLink-Setup-<version>.exe>');
      try { return out(require('../lib/connector').publish(path.resolve(arg))); } catch (e) { fail(e.message); } }
    case 'outbox': { // outgoing mail: DRAFTS only. There is no approve and no send command: the owner approves the exact content with a button on the card.
      const flds = () => { const b = {}; if (opt.json) { try { Object.assign(b, JSON.parse(opt.json)); } catch { fail('--json is not valid JSON'); } }
        for (const k of ['kind', 'to', 'cc', 'bcc', 'subject', 'body', 'attach', 'task']) if (opt[k] !== undefined && opt[k] !== true) b[k] = opt[k];
        if (opt['reply-email'] !== undefined) b.reply_email = opt['reply-email']; if (opt['no-card']) b.submit = false; if (opt.long) b.long = true; return b; };
      if (sub === 'draft') return out(await api('POST', '/api/outbox', flds()));
      if (sub === 'update') { if (!arg) fail('usage: outbox update <id> [--to ...] [--subject ...] [--body ...]'); return out(await api('PATCH', `/api/outbox/${arg}`, flds())); }
      if (sub === 'submit') { if (!arg) fail('missing id'); return out(await api('POST', `/api/outbox/${arg}/submit`, {})); }
      if (sub === 'cancel') { if (!arg) fail('missing id'); return out(await api('POST', `/api/outbox/${arg}/cancel`, {})); }
      if (sub === 'list') return out(await api('GET', '/api/outbox' + qs(opt, ['status', 'limit'])));
      if (sub === 'show') { if (!arg) fail('missing id'); return out(await api('GET', `/api/outbox/${arg}`)); }
      break; }
    case 'style': { // WRITING STYLES (docs/WRITING-STYLES.md): `style for` before any mail; the outbox / draft commands enforce the result
      const ctx = () => pick(opt, ['to', 'cc', 'task']); const re = opt['reply-email'] !== undefined ? { reply_email: opt['reply-email'] } : {};
      if (sub === 'for') { if (!opt.to && !opt['reply-email'] && !opt.task) fail('usage: style for --to "a@b.com, Name" [--cc ..] [--reply-email ID] [--task ID]'); return out(await api('GET', '/api/styles/for' + qs({ ...ctx(), ...re }, ['to', 'cc', 'task', 'reply_email']))); }
      if (sub === 'check') { if (!opt.body) fail('usage: style check --to "..." --body "..." [--reply-email ID] [--long]'); return out(await api('POST', '/api/styles/check', { ...ctx(), ...re, body: opt.body, long: !!opt.long })); }
      if (sub === 'feedback') { if (!opt.to) fail('usage: style feedback --to "a@b.com, Name"'); return out(await api('GET', '/api/styles/feedback' + qs({ ...ctx(), limit: opt.limit }, ['to', 'cc', 'limit']))); }
      if (sub === 'list') return out(await api('GET', '/api/styles'));
      if (sub === 'show') { if (!arg) fail('usage: style show <key|id>'); return out(await api('GET', `/api/styles/${encodeURIComponent(arg)}`)); }
      if (sub === 'suggest') { // the assistant cannot change rules: this becomes a suggestion the owner accepts in Settings
        if (!arg) fail('usage: style suggest <key|id> --reason "..." [--max-sentences N] [--max-words N] [--greeting "..."] [--closing "..."] [--formality casual|neutral|formal] [--forbid "a,b"]');
        const rules = {}; if (opt['max-sentences']) rules.max_sentences = opt['max-sentences']; if (opt['max-words']) rules.max_words = opt['max-words']; for (const k of ['greeting', 'closing', 'formality', 'language']) if (typeof opt[k] === 'string') rules[k] = opt[k];
        const cur = await api('GET', `/api/styles/${encodeURIComponent(arg)}`); if (opt.forbid) rules.forbidden_phrases = [...cur.rules.forbidden_phrases, ...String(opt.forbid).split(',').map((x) => x.trim())];
        return out(await api('PATCH', `/api/styles/${encodeURIComponent(arg)}`, { rules, reason: opt.reason, ...(typeof opt.description === 'string' ? { description_he: opt.description } : {}) })); }
      if (sub === 'analyse' || sub === 'analyze' || sub === 'try') { // background runs of the assistant on the owner's SENT mail: owner / developer only
        if (process.env.MESIMOT_AGENT_MODE) fail('this command is not available to the assistant');
        const args = sub === 'try' ? ['--style-try', JSON.stringify({ to: opt.to, say: opt.say, cc: opt.cc })] : ['--style-analyse', JSON.stringify({ person: opt.person, group: opt.group, role: opt.role, classify: opt.classify, domains: opt.domains, default: !!opt.default, force: !!opt.force, dry: !!opt.dry, budget: opt.budget, all: !opt.person && !opt.group && !opt.role && !opt.default })];
        if (sub === 'try' && (!opt.to || !opt.say)) fail('usage: style try --to "..." --say "what the mail should say"   (a dry run: nothing is saved or sent)');
        const r = require('child_process').spawnSync(process.execPath, [require('path').join(__dirname, 'mesimot-runner'), ...args], { stdio: 'inherit' });
        process.exit(r.status ?? 2); }
      fail('usage: style for|check|feedback|list|show|suggest|analyse|try'); }
    case 'confirm':
      if (sub === 'task-delete') { if (!arg) fail('usage: confirm task-delete <task id>'); return out(await api('POST', '/api/confirm', { kind: 'task_delete', id: arg })); }
      if (sub === 'project-delete') { if (!arg) fail('usage: confirm project-delete <project> --tasks move:<project>|unassign|delete'); return out(await api('POST', '/api/confirm', { kind: 'project_delete', id: arg, payload: { tasks: opt.tasks || 'unassign', ...(opt.facts ? { facts: opt.facts } : {}), ...(opt.protocols ? { protocols: opt.protocols } : {}) } })); }
      if (sub === 'person-delete') { if (!arg) fail('usage: confirm person-delete <person id>'); return out(await api('POST', '/api/confirm', { kind: 'person_delete', id: arg })); }
      if (sub === 'protocol-delete') { if (!arg) fail('usage: confirm protocol-delete <protocol id>'); return out(await api('POST', '/api/confirm', { kind: 'protocol_delete', id: arg })); }
      break;
    case 'trash': // the recycle bin: list and restore are free; delete and empty are permanent and go through the owner's confirmation
      if (sub === 'list') return out(await api('GET', '/api/trash' + qs(opt, ['kind', 'limit'])));
      if (sub === 'restore') { if (!arg) fail('usage: trash restore <trash id>'); return out(await api('POST', `/api/trash/${arg}/restore`, {})); }
      if (sub === 'delete') { if (!arg) fail('usage: trash delete <trash id>'); return out(await api('POST', '/api/confirm', { kind: 'trash_delete', id: arg })); }
      if (sub === 'empty') return out(await api('POST', '/api/confirm', { kind: 'trash_empty' }));
      break;
    case 'filter':
      if (sub === 'list') return out(await api('GET', '/api/filters'));
      if (sub === 'add') {
        const kind = opt.sender ? 'sender' : opt.domain ? 'domain' : opt.regex ? 'regex' : opt.text ? 'text' : null;
        if (!kind) fail('usage: filter add --sender a@b | --domain b.com | --text "phrase" | --regex "..." [--field subject|body] [--project P] --action skip|fyi|relevant');
        const body = { kind, pattern: opt[kind === 'regex' ? 'regex' : kind], action: opt.action || 'skip', field: opt.field, project: opt.project, note: opt.note };
        const prev = await api('POST', '/api/filters/preview', body);
        const rule = await api('POST', '/api/filters', body);
        return out({ rule, last_30_days: { total_mails: prev.total, would_match: prev.matches, examples: prev.examples } });
      }
      if (sub === 'preview') { const kind = opt.sender ? 'sender' : opt.domain ? 'domain' : opt.regex ? 'regex' : 'text'; return out(await api('POST', '/api/filters/preview', { kind, pattern: opt[kind === 'regex' ? 'regex' : kind] || opt.text, action: opt.action || 'skip', field: opt.field, project: opt.project })); }
      if (sub === 'delete') { if (!arg) fail('missing filter id'); return out(await api('DELETE', `/api/filters/${arg}`)); }
      if (sub === 'disable' || sub === 'enable') { if (!arg) fail('missing filter id'); return out(await api('PATCH', `/api/filters/${arg}`, { enabled: sub === 'enable' })); }
      break;
    case 'person':
      if (sub === 'list') return out(await api('GET', '/api/people'));
      if (sub === 'find') { const needle = pos.slice(2).join(' ').toLowerCase(); if (!needle) fail('usage: person find "<name, email or company>"'); const all = await api('GET', '/api/people'); return out(all.filter((x) => [x.name_he, x.name_en, x.company, x.role_text, ...(x.emails || [])].filter(Boolean).join(' ').toLowerCase().includes(needle)).slice(0, 15).map((x) => ({ id: x.id, name_he: x.name_he, name_en: x.name_en, role: x.role, company: x.company, role_text: x.role_text, emails: x.emails, status: x.status }))); }
      if (sub === 'add') { const b = pick(opt, ['name', 'role', 'emails', 'notes', 'status', 'company']); if (opt['name-en']) b.name_en = opt['name-en']; if (opt['role-text']) b.role_text = opt['role-text']; return out(await api('POST', '/api/people', b)); }
      if (sub === 'update') { if (!arg) fail('missing person'); const b = pick(opt, ['name', 'role', 'emails', 'notes', 'status', 'company']); if (opt['role-text'] !== undefined) b.role_text = opt['role-text']; if (opt['name-en'] !== undefined) b.name_en = opt['name-en']; return out(await api('PATCH', `/api/people/${encodeURIComponent(arg)}`, b)); }
      if (sub === 'resolve') { if (!arg) fail('usage: person resolve <partial_id> --into <full_id> | --name ... --emails ... --company ... --role-text ...'); const b = pick(opt, ['into', 'name', 'emails', 'email', 'company', 'notes']); if (opt['role-text']) b.role_text = opt['role-text']; if (opt['name-en']) b.name_en = opt['name-en']; return out(await api('POST', `/api/people/${encodeURIComponent(arg)}/resolve`, b)); }
      if (sub === 'show') { if (!arg) fail('missing person'); return out(await api('GET', `/api/people/${encodeURIComponent(arg)}`)); }
      if (sub === 'merge') { if (!arg || !pos[3]) fail('usage: person merge <from> <into>'); return out(await api('POST', `/api/people/${encodeURIComponent(arg)}/merge`, { into: pos[3] })); }
      break;
    case 'attention':
      if (sub === 'list') return out(await api('GET', '/api/attention' + qs(opt, ['status'])));
      if (sub === 'add') return out(await api('POST', '/api/attention', pick(opt, ['kind', 'text', 'task'])));
      if (sub === 'update') return out(await api('PATCH', `/api/attention/${arg}`, pick(opt, ['status'])));
      break;
    default:
  }
  console.error(USAGE);
  process.exit(2);
}

main().catch((e) => fail(e.message));
