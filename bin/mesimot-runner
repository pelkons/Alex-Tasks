#!/usr/bin/env node
'use strict';
const { createRunner, open } = require('../lib/runner');
const runner = createRunner(open(process.env.MESIMOT_DB));
if (process.argv.includes('--reconcile')) runner.reconcileOnce().then((ok) => { console.log(ok ? 'reconciliation done' : 'another run is active, gave up'); process.exit(ok ? 0 : 1); });
else if (process.argv.includes('--housekeeping')) runner.housekeepingOnce(process.argv.includes('--dry-run')).then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); });
else if (process.argv.includes('--mentions-backfill')) { console.log(JSON.stringify(runner.entities.backfill())); process.exit(0); }
else if (process.argv.includes('--names')) runner.nameFixOnce().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); });
else if (process.argv.includes('--pulse')) runner.pulseOnce({ force: process.argv.includes('--force') }).then((r) => { console.log(JSON.stringify({ ...r, items: undefined })); process.exit(0); }).catch((e) => { console.error(e); process.exit(1); });
else if (process.argv.includes('--audit-import')) { runner.auditImportOnce(+process.argv[process.argv.indexOf('--audit-import') + 1]).then((n) => { console.log(n + ' proposals'); process.exit(0); }); }
else if (process.argv.includes('--audit-people')) { console.log(runner.auditPeopleOnce() + ' proposals'); process.exit(0); }
else if (process.argv.includes('--usage-weekly')) { runner.weeklyUsage(); process.exit(0); }
else if (process.argv.includes('--curator')) runner.curatorOnce({ force: process.argv.includes('--force') }).then((r) => { console.log(JSON.stringify(r)); process.exit(0); }).catch((e) => { console.error(e); process.exit(1); });
else if (process.argv.includes('--daily')) runner.dailyOnce().then(() => process.exit(0));
else if (process.argv.includes('--files-backfill')) { const ids = (process.argv[process.argv.indexOf('--files-backfill') + 1] || '').split(',').map(Number).filter(Boolean); runner.filesBackfillOnce(ids).then((ok) => { console.log(ok ? 'files backfill done' : 'files backfill failed'); process.exit(ok ? 0 : 1); }); }
else if (process.argv.includes('--facts-backfill')) { const ids = (process.argv[process.argv.indexOf('--facts-backfill') + 1] || '').split(',').map(Number).filter(Boolean); runner.factsBackfillOnce(ids).then((ok) => { console.log(ok ? 'facts backfill done' : 'facts backfill failed'); process.exit(ok ? 0 : 1); }); }
else if (process.argv.includes('--profile-backfill')) { const ids = (process.argv[process.argv.indexOf('--profile-backfill') + 1] || '').split(',').map(Number).filter(Boolean); runner.profileBackfillOnce(ids).then((rep) => { console.log(JSON.stringify(rep, null, 1)); process.exit(rep.some((x) => x.error) ? 1 : 0); }).catch((e) => { console.error(e); process.exit(1); }); }
else runner.start();
